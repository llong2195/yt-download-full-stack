# Database Configuration
# SQLite database file path (relative to backend directory)
DATABASE_URL=sqlite:///./data/ytdownloader.db

# Huey Task Queue Database
# SQLite database file for Huey task queue (relative to backend directory)
HUEY_DB=./data/huey.db

# Download Storage Directory
# Directory where downloaded videos will be stored (relative to backend directory)
# Structure: downloads/{channel_id}/{video_id}.mp4
DOWNLOAD_DIR=./downloads

# API Server Configuration
# Port for the FastAPI backend server
API_PORT=8000

# Debug Mode
# Set to true for development (enables SQL echo, detailed error messages)
# Set to false for production
DEBUG=false

# CORS Origins
# Comma-separated list of allowed origins for CORS
# Include frontend dev server and any browser extensions
CORS_ORIGINS=http://localhost:5173,chrome-extension://*

# Logging Configuration (optional)
# LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log
